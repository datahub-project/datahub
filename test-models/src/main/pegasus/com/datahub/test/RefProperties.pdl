namespace com.datahub.test

/**
 * Properties associated with a Tag
 */
@Aspect = {
  "name": "RefProperties"
}
record RefProperties {
  /**
   * Display name of the ref
   */
  @Searchable = {
    "v3": {
      "queryByDefault": true
    },
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ]
  }
  name: string
}