  "view_definition": "version: 1.1\n\nsource: main.obda_metric_test.pos_eod\n\njoins:\n  - name: cpty\n    source: main.obda_metric_test.cpty_mstr\n    \"on\": source.cpty_id = cpty.cpty_id\n  - name: instr\n    source: main.obda_metric_test.instr_ref\n    \"on\": source.instr_id = instr.instr_id\n    joins:\n      - name: issuer\n        source: main.obda_metric_test.cpty_mstr\n        \"on\": instr.issuer_cpty_id = issuer.cpty_id\n\nfilter: mv_usd IS NOT NULL\n\ndimensions:\n  - name: jurisdiction\n    expr: cpty.ctry_cd\n\n  - name: counterparty\n    expr: cpty.legal_nm\n\n  - name: asset_class\n    expr: instr.asset_cls_cd\n\n  - name: issuer_jurisdiction\n    expr: instr.issuer.ctry_cd\n\n  - name: book\n    expr: source.book_cd\n\n  - name: cob_date\n    expr: source.cob_dt\n\nmeasures:\n  - name: market_value\n    expr: SUM(source.mv_usd)\n\n  - name: notional\n    expr: SUM(source.ntnl_amt)\n\n  - name: position_count\n    expr: COUNT(1)\n\n  - name: avg_market_value\n    expr: MEASURE(market_value) / MEASURE(position_count)\n\n  - name: market_value_trailing_5d\n    expr: SUM(source.mv_usd)\n    window:\n      - order: cob_date\n        semiadditive: last\n        range: trailing 5 day\n\nmaterialization:\n  schedule: EVERY 6 HOURS\n  mode: relaxed\n  materialized_views:\n    - name: by_jurisdiction\n      type: aggregated\n      dimensions:\n        - jurisdiction\n        - cob_date\n      measures:\n        - market_value\n        - position_count",
