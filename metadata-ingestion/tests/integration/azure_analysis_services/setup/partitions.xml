          <row>
            <ID>300</ID>
            <TableID>10</TableID>
            <Name>Sales-Partition</Name>
            <Type>4</Type>
            <QueryDefinition>let Source = Sql.Database("myserver.database.windows.net", "salesdb", [Query="SELECT * FROM dbo.sales"]) in Source</QueryDefinition>
            <DataSourceID>600</DataSourceID>
          </row>
          <row>
            <ID>301</ID>
            <TableID>11</TableID>
            <Name>Product-Partition</Name>
