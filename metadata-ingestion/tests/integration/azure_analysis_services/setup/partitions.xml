            <QueryDefinition>let Source = Sql.Database("myserver.database.windows.net", "salesdb", [Query="SELECT * FROM dbo.product"]) in Source</QueryDefinition>
            <DataSourceID>600</DataSourceID>
          </row>
          <row>
            <ID>302</ID>
            <TableID>12</TableID>
            <Name>SalesSummary-Partition</Name>
            <Type>7</Type>
