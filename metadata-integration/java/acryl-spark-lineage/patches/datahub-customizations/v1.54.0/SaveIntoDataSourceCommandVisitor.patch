+  static String parseCreateTableName(String sql) {
+    if (sql == null || !sql.toLowerCase(Locale.ROOT).contains("create table")) {
+      return null;
+    }
+    String[] tokens = sql.split("\\s+");
+    for (int i = 0; i < tokens.length - 1; i++) {
