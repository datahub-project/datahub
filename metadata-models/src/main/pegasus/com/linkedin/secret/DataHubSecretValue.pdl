namespace com.linkedin.secret

import com.linkedin.common.AuditStamp

/**
 * The value of a DataHub Secret
 */
@Aspect = {
  "name": "dataHubSecretValue"
}
record DataHubSecretValue {
  /**
   * The display name for the secret
   */
  @Searchable = {
   "fieldType": "TEXT_PARTIAL",
   "boostScore": 10.0,
   "v3": {
     "searchLabel": "name",
     "mappings": [
       { "type": "KEYWORD" },
       { "subfield": "text", "type": "TEXT" },
       { "subfield": "stemmed", "type": "STEMMED" }
     ]
   }
  }
  name: string

  /**
   * The AES-encrypted value of the DataHub secret.
   */
  value: string

  /**
   * Description of the secret
   */
  description: optional string

  /**
   * Created Audit stamp.
   * Search V3 does not index this time. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time.
   */
   @deprecated = "Use systemMetadata.aspectCreated instead."
   @Searchable = {
     "/time": {
      "fieldName": "createdTime",
      "fieldType": "DATETIME",
      "v3": { "enabled": false }
     }
   }
   created: optional AuditStamp
}