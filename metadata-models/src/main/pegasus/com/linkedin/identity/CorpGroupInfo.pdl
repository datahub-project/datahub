namespace com.linkedin.identity

import com.linkedin.common.CorpGroupUrn
import com.linkedin.common.CorpuserUrn
import com.linkedin.common.EmailAddress
import com.linkedin.common.AuditStamp

/**
 * Information about a Corp Group ingested from a third party source
 */
@Aspect = {
  "name": "corpGroupInfo",
  "schemaVersion": 2
}
@Aspect.EntityUrns = [ "com.linkedin.common.CorpGroupUrn" ]
record CorpGroupInfo {

  /**
   * The name of the group.
   */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "queryByDefault": true,
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  displayName: optional string

  /**
   * email of this group
   */
  email: optional EmailAddress

  /**
   * owners of this group
   * Deprecated! Replaced by Ownership aspect.
   * Relationship annotation intentionally omitted so OwnedBy edges are owned solely by the ownership aspect.
   */
  @deprecated
  admins: array[CorpuserUrn]

  /**
   * List of ldap urn in this group.
   * Deprecated! Replaced by GroupMembership aspect.
   */
  @Relationship = {
    "/*": {
      "name": "IsPartOf",
      "entityTypes": [ "corpuser" ]
    }
  }
  @deprecated
  members: array[CorpuserUrn]

  /**
   * List of groups in this group.
   * Deprecated! This field is unused.
   */
   @Relationship = {
     "/*": {
       "name": "IsPartOf",
       "entityTypes": [ "corpGroup" ]
     }
   }
  @deprecated
  groups: array[CorpGroupUrn]

  /**
   * A description of the group.
   */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * Slack channel for the group
   */
  slack: optional string

  /**
   * When this group was created in DataHub.
   * Search V3 does not index this time. It is systemMetadata.aspectCreated,
   * copied to _system.created.time.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
      "fieldName": "createdTime",
      "fieldType": "DATETIME",
      "v3": { "enabled": false }
    }
  }
  created: optional AuditStamp
}
