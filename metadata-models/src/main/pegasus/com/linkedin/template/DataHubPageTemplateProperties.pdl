namespace com.linkedin.template

import com.linkedin.common.AuditStamp

/**
 * The main properties of a DataHub page template
 */
@Aspect = {
  "name": "dataHubPageTemplateProperties",
  "schemaVersion": 2
}
record DataHubPageTemplateProperties  {
  /**
   * The rows of modules contained in this template
   */
  @Relationship = {
    "/*/modules/*": {
      "name": "ContainedIn",
      "entityTypes": [ "dataHubPageModule" ]
    }
  } 
  rows: array[DataHubPageTemplateRow]

  /**
   * The optional info for asset summaries. Should be populated if surfaceType is ASSET_SUMMARY
   */
  assetSummary: optional DataHubPageTemplateAssetSummary

  /**
   * Info about the surface area of the product that this template is deployed in
   */
  surface: DataHubPageTemplateSurface

  /**
   * Info about the visibility of this template
   */
  visibility: DataHubPageTemplateVisibility

  /**
   * Audit stamp for when and by whom this template was created.
   * Search V3 does not index this stamp. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time and _system.created.actor.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
       "fieldType": "DATETIME",
       "fieldName": "createdAt",
       "v3": { "enabled": false }
    },
    "/actor": {
      "fieldType": "URN",
      "fieldName": "createdBy",
      "v3": { "enabled": false }
    }
  }
  created: AuditStamp
  
  /**
   * Audit stamp for when and by whom this template was last updated.
   * Search V3 does not index this time. The write is systemMetadata.aspectModified,
   * copied to _system.modified.time.
   */
  @deprecated = "Use systemMetadata.aspectModified instead."
  @Searchable = {
    "/time": {
       "fieldType": "DATETIME",
       "fieldName": "lastModifiedAt",
       "v3": { "enabled": false }
    }
  }
  lastModified: AuditStamp
}
