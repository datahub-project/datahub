namespace com.linkedin.ingestion

import com.linkedin.common.Urn
import com.linkedin.timeseries.TimeseriesAspectBase

/**
 * A change in the status of one of the ingestion source's runs, recorded each time an execution
 * request for the source is created or its result status changes. Each event holds facts about
 * that one run only; the source's latest run, last success and last failure are kept in
 * dataHubIngestionSourceRunSummary.
 *
 * A rollback changes an old run's status, so it adds events for that run to the history. Events
 * have no retention, as for assertionRunEvent; there are a few per run.
 */
@Aspect = {
  "name": "dataHubIngestionSourceRunEvent",
  "type": "timeseries"
}
record DataHubIngestionSourceRunEvent includes TimeseriesAspectBase {

  /**
   * The execution request (run) this event reports on. Requests are cleaned up after a retention
   * period, so the request may no longer exist.
   */
  @TimeseriesField = {}
  @UrnValidation = {
    "exist": false,
    "strict": true,
    "entityTypes": [ "dataHubExecutionRequest" ]
  }
  executionRequest: Urn

  /**
   * Time at which the execution request was created, as epoch at UTC in milliseconds.
   */
  @TimeseriesField = {}
  requestedAtMillis: long

  /**
   * Status of the run as reported by the executor, e.g. RUNNING, SUCCESS, FAILURE, TIMEOUT or
   * ROLLED_BACK, or PENDING before the executor reports a result.
   */
  @TimeseriesField = {}
  status: string

  /**
   * The ingestion source's type when the run was requested, e.g. mysql or bigquery, so the run
   * history can be filtered by platform.
   */
  @TimeseriesField = {}
  sourceType: optional string

  /**
   * The executor the run was requested on.
   */
  @TimeseriesField = {}
  executorId: optional string
}
