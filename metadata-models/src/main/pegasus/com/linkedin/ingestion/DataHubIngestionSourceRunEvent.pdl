namespace com.linkedin.ingestion

import com.linkedin.common.Urn
import com.linkedin.timeseries.TimeseriesAspectBase

/**
 * A change in the status of one of the ingestion source's runs, recorded each time an execution
 * request for the source is created or its result status changes.
 *
 * The searchable fields are copied onto the source's search document by every event, so the
 * source can be sorted and filtered by its latest run. Events for a run that is no longer the
 * source's newest request are not written, so an older run finishing late cannot replace them.
 */
@Aspect = {
  "name": "dataHubIngestionSourceRunEvent",
  "type": "timeseries"
}
record DataHubIngestionSourceRunEvent includes TimeseriesAspectBase {

  /**
   * The execution request (run) this event reports on.
   */
  @TimeseriesField = {}
  executionRequest: Urn

  /**
   * Time at which the execution request was created, as epoch at UTC in milliseconds.
   */
  @Searchable = {
    "fieldName": "lastRunRequestedAtMillis",
    "fieldType": "DATETIME",
    "queryByDefault": false
  }
  requestedAtMillis: long

  /**
   * Status of the run as reported by the executor, e.g. RUNNING, SUCCESS, FAILURE or DUPLICATE,
   * or PENDING before the executor reports a result. A DUPLICATE request is newer than the run it
   * duplicates, so it becomes the source's last run, as in the run history.
   */
  @TimeseriesField = {}
  @Searchable = {
    "fieldName": "lastRunStatus",
    "fieldType": "KEYWORD",
    "queryByDefault": false
  }
  status: string

  /**
   * Set to requestedAtMillis on SUCCESS events only, so the source keeps the request time of its
   * last successful run.
   */
  @Searchable = {
    "fieldName": "lastSuccessfulRunRequestedAtMillis",
    "fieldType": "DATETIME",
    "queryByDefault": false
  }
  successfulRunRequestedAtMillis: optional long

  /**
   * Set to requestedAtMillis on FAILURE events only, so the source keeps the request time of its
   * last failed run.
   */
  @Searchable = {
    "fieldName": "lastFailedRunRequestedAtMillis",
    "fieldType": "DATETIME",
    "queryByDefault": false
  }
  failedRunRequestedAtMillis: optional long
}
