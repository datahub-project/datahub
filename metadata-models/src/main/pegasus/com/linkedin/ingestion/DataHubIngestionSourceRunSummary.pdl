namespace com.linkedin.ingestion

import com.linkedin.common.Urn

/**
 * Derived.
 * Summary of the most recent execution request for an ingestion source, kept in sync from the
 * source's execution requests so that sources can be sorted and filtered by their latest run.
 */
@Aspect = {
  "name": "dataHubIngestionSourceRunSummary"
}
record DataHubIngestionSourceRunSummary {

  /**
   * Urn of the most recent execution request for this ingestion source.
   */
  lastExecutionRequest: Urn

  /**
   * Time at which the most recent execution request was created, as epoch at UTC in milliseconds.
   */
  @Searchable = {
    "fieldName": "lastRunRequestedAtMillis",
    "fieldType": "DATETIME",
    "queryByDefault": false
  }
  lastRunRequestedAtMillis: long

  /**
   * Status of the most recent execution request, copied as-is from its result, e.g. RUNNING,
   * SUCCESS, FAILURE or DUPLICATE. A newer DUPLICATE request therefore replaces the status of the
   * run it duplicated. Absent until the executor reports a result.
   */
  @Searchable = {
    "fieldName": "lastRunStatus",
    "fieldType": "KEYWORD",
    "queryByDefault": false
  }
  lastRunStatus: optional string
}
