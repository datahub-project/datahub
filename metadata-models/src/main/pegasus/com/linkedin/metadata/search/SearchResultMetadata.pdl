namespace com.linkedin.metadata.search

import com.linkedin.common.Urn

/**
 * The model for the search result
 */
record SearchResultMetadata {

  /**
   * A list of search result metadata such as aggregations
   */
  aggregations: array[AggregationMetadata] = []

  /**
   * A list of search query suggestions based on the given query
   */
  suggestions: array[SearchSuggestion] = []

  /**
   * Templates visited while choosing this result. Set when the caller asks for an explanation.
   */
  routeChain: optional array[string]

  /**
   * How the served template's keywordRerank ordered this result. Set when the caller asks for an
   * explanation and the served rung declares keywordRerank.
   */
  keywordRerank: optional KeywordRerankExplanation

  /**
   * How the served template's vector rung retrieved this result. Set when the caller asks for an
   * explanation and the served rung declares combine: vector.
   */
  vectorRetrieval: optional VectorRetrievalExplanation

  /**
   * Set when a search served keyword search results because the template serving it could not
   * embed the query and the caller set SearchFlags.keywordFallbackOnEmbeddingFailure: why the
   * embedding failed (timeout, rejected, reserveExhausted, budgetExhausted, or failed).
   */
  keywordFallback: optional string

}