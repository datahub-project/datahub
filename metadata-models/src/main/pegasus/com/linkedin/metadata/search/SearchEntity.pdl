namespace com.linkedin.metadata.search

import com.linkedin.common.Urn

/**
 * The model for each entity returned by the search query
 */
record SearchEntity {
  /**
   * Urn of the entity being returned
   */
  entity: Urn

  /**
   * Matched field name and values
   */
  matchedFields: array[record MatchedField {
    /**
     * Matched field name
     */
    name: string

    /**
     * Matched field value
     */
    value: string
  }] = []

  /**
   * How each field matched. Set when the caller asks for an explanation.
   */
  explainMatches: optional array[record ExplainMatch {
    /**
     * The same name a matched field reports: a logical field, or a structured property URN.
     */
    field: string

    /**
     * Matched text.
     */
    value: string

    /**
     * Indexed path that matched, such as {@code name.keyword} or {@code name.stemmed}.
     */
    subfield: string

    /**
     * One of {@code exact}, {@code prefix}, {@code word}, {@code contains}, or {@code nameAndValue}.
     */
    mode: string

    /**
     * Query text that produced the hit.
     */
    query: string
  }]

  features: optional map[string, double]

  score: optional double

  /**
   * A list of the the restricted aspects on the entity.
   * If the key aspect is present, assume ALL aspects should be restricted including the entity's Urn.
   */
  restrictedAspects: optional array[string]

   /**
    * Extra fields from the search document based on what is requested in the search request
    */
   extraFields: optional map[string, string]
}