namespace com.linkedin.metadata.recommendation

/**
 * Recommendation modules that can be requested for a scenario
 */
enum RecommendationModuleID {

  /**
   * Recommendation module for top domains
   */
  DOMAINS,

  /**
   * Recommendation module for top platforms
  */
  PLATFORMS,

  /**
   * Recommendation module for most popular entities
   */
  HIGH_USAGE_ENTITIES,

  /**
   * Recommendation module for top glossary terms
   */
  TOP_TERMS,

  /**
   * Recommendation module for top tags
   */
  TOP_TAGS,


  /**
    * Recommendation module for recently edited entities
   */
   RECENTLY_EDITED_ENTITIES,

  /**
   * Recommendation module for recently viewed entities
  */
  RECENTLY_VIEWED_ENTITIES,

  /**
   * Recommendation module for recent searches
  */
    RECENT_SEARCHES

}
