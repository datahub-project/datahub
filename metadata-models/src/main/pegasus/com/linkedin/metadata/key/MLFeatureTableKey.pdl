namespace com.linkedin.metadata.key

import com.linkedin.common.Urn

/**
 * Key for an MLFeatureTable
 */
@Aspect = {
  "name": "mlFeatureTableKey",
  "schemaVersion": 2
}
record MLFeatureTableKey {
  /**
  * Data platform urn associated with the feature table
  */
  @Relationship = {
    "name": "SourcePlatform",
    "entityTypes": [ "dataPlatform" ]
  }
  @Searchable = {
    "fieldType": "URN",
    "queryByDefault": false,
    "enableAutocomplete": true,
    "v3": {
      "searchLabel": "platform",
      "copyToOther": true
    }
  }
  platform: Urn

  /**
  * Name of the feature table
  */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string
}
