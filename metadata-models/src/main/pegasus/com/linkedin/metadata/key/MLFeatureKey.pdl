namespace com.linkedin.metadata.key

/**
 * Key for an MLFeature
 */
@Aspect = {
  "name": "mlFeatureKey"
}
record MLFeatureKey {

  /**
   * Namespace for the feature
   */
  @Searchable = {
    "v3": {
      "queryByDefault": true
    },
    "fieldType": "TEXT_PARTIAL",
  }
  featureNamespace: string

  /**
   * Name of the feature
   */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string
}
