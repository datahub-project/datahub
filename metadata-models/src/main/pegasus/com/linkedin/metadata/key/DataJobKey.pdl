namespace com.linkedin.metadata.key

import com.linkedin.common.Urn

/**
 * Key for a Data Job
 */
@Aspect = {
  "name": "dataJobKey"
}
record DataJobKey {
  /**
  * Standardized data processing flow urn representing the flow for the job
  */
  @Searchable = {
    "fieldName": "dataFlow",
    "fieldType": "URN_PARTIAL",
    "queryByDefault": false,
    "v3": {
      "searchLabel": "parent",
      "queryByDefault": false,
      "hasValuesFieldName": "hasParent"
    }
  }
  @Relationship = {
    "name": "IsPartOf",
    "entityTypes": [ "dataFlow" ]
  }
  flow: Urn

  /**
  * Unique Identifier of the data job
  */
  @Searchable = {
    "v3": {
      "queryByDefault": true,
      "searchLabel": "id",
      "boostScore": 2.0,
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    },
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true
  }
  jobId: string
}
