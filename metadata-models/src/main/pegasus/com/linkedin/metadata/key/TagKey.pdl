namespace com.linkedin.metadata.key

/**
 * Key for a Tag
 */
@Aspect = {
  "name": "tagKey"
}
record TagKey {
  /**
  * The tag name, which serves as a unique id
  */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldName": "id",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string
}
