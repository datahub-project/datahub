namespace com.linkedin.metadata.key

/**
 * Key for a Tag
 */
@Aspect = {
  "name": "tagKey",
  "schemaVersion": 2
}
record TagKey {
  /**
  * The tag name, which serves as a unique id
  */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldName": "id",
    "searchLabel": "name"
  }
  name: string
}
