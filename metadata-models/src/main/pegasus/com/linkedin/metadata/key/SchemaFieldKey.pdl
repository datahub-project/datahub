namespace com.linkedin.metadata.key

import com.linkedin.common.Urn

/**
 * Key for a SchemaField
 */
@Aspect = {
  "name": "schemaFieldKey"
}
record SchemaFieldKey {
  /**
  * Parent associated with the schema field
  */
  @Searchable = {
    "v3": {
      "queryByDefault": false,
      "searchLabel": "parent",
      "hasValuesFieldName": "hasParent"
    },
    "fieldType": "URN",
  }
  parent: Urn

  /**
  * fieldPath identifying the schema field
  */
  @Searchable = {
    "fieldType": "KEYWORD",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "id",
      "boostScore": 2.0,
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  fieldPath: string
}
