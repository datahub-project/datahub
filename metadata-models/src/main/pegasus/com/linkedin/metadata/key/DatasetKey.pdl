namespace com.linkedin.metadata.key

import com.linkedin.common.Urn
import com.linkedin.common.FabricType

/**
 * Key for a Dataset
 */
@Aspect = {
  "name": "datasetKey",
  "schemaVersion": 2
}
record DatasetKey {
  /**
  * Data platform urn associated with the dataset
  */
  @Searchable = {
    "fieldType": "URN",
    "enableAutocomplete": true,
    "v3": {
      "searchLabel": "platform",
      "copyToOther": true
    }
  }
  platform: Urn

  /**
  * Unique guid for dataset
  */
  //This is no longer to be used for Dataset native name. Use name, qualifiedName from DatasetProperties instead.
  @Searchable = {
    "fieldName": "id",
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Fabric type where dataset belongs to or where it was generated.
   */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "addToFilters": true,
    "filterNameOverride": "Environment",
    "queryByDefault": false,
    "v3": {
      "searchLabel": "origin",
      "mappings": [
        { "type": "KEYWORD" }
      ]
    }
  }
  origin: FabricType
}
