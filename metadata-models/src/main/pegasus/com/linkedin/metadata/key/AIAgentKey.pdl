namespace com.linkedin.metadata.key

/**
 * Key for an AI Agent entity
 */
@Aspect = {
  "name": "aiAgentKey"
}
record AIAgentKey {
  /**
   * Unique identifier for the agent, e.g. "ask-datahub" or a generated UUID
   */
  @Searchable = {
    "v3": {
      "queryByDefault": true,
      "searchLabel": "id",
      "boostScore": 2.0,
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  id: string
}
