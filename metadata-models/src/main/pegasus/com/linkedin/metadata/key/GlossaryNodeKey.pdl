namespace com.linkedin.metadata.key

import com.linkedin.common.Urn
import com.linkedin.common.FabricType

/**
 * Key for a GlossaryNode
 */
@Aspect = {
  "name": "glossaryNodeKey",
  "schemaVersion": 2
}
record GlossaryNodeKey {

  /**
   * Unique id for the node. Callers may supply one; otherwise creation stores a UUID.
   * The display name is GlossaryNodeInfo.name.
   */
  @Searchable = {
    "v3": {
      "queryByDefault": true,
      "searchLabel": "id",
      "boostScore": 2.0,
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    },
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "fieldName": "id"
  }
  name: string

}
