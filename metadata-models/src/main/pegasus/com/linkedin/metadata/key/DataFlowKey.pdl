namespace com.linkedin.metadata.key

/**
 * Key for a Data Flow
 */
@Aspect = {
  "name": "dataFlowKey"
}
record DataFlowKey {
  /**
  * Workflow manager like azkaban, airflow which orchestrates the flow
  */
  @Searchable = {
    "v3": {
      "queryByDefault": false,
      "searchLabel": "tool",
      "boostScore": 1.0
    },
    "fieldType": "TEXT_PARTIAL"
  }
  orchestrator: string

  /**
  * Unique Identifier of the data flow
  */
  @Searchable = {
    "v3": {
      "queryByDefault": true,
      "searchLabel": "id",
      "boostScore": 2.0,
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    },
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true
  }
  flowId: string

  /**
  * Cluster where the flow is executed
  */
  @Searchable = {
    "v3": {
      "queryByDefault": false,
      "searchLabel": "location",
      "copyToOther": true,
      "boostScore": 1.0
    },
    "fieldType": "TEXT_PARTIAL"
  }
  cluster: string
}
