namespace com.linkedin.metadata.key

/**
 * Key for a CorpUser
 */
@Aspect = {
  "name": "corpUserKey"
}
record CorpUserKey {
  /**
  * The name of the AD/LDAP user.
  */
  @Searchable = {
    "v3": {
      "queryByDefault": true
    },
    "fieldName": "ldap",
    "fieldType": "WORD_GRAM",
    "boostScore": 2.0,
    "enableAutocomplete": true
  }
  username: string
}
