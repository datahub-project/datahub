namespace com.linkedin.metadata.key

import com.linkedin.common.FabricType

/**
 * Key for a Data Process
 */
@Aspect = {
  "name": "dataProcessKey"
}
record DataProcessKey {
  /**
  * Process name i.e. an ETL job name
  */
  @Searchable = {
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "boostScore": 10.0,
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    },
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 4.0
  }
  name: string

  /**
  * Standardized Orchestrator where data process is defined.
  * TODO: Migrate towards something that can be validated like DataPlatform urn
  */
  @Searchable = {
    "v3": {
      "queryByDefault": false,
      "searchLabel": "tool",
      "boostScore": 1.0
    },
    "fieldType": "TEXT_PARTIAL",
    "enableAutocomplete": true
  }
  orchestrator: string

  /**
  * Fabric type where dataset belongs to or where it was generated.
  */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "queryByDefault": false,
    "v3": {
      "searchLabel": "origin",
      "queryByDefault": false,
      "mappings": [
        { "type": "KEYWORD" }
      ]
    }
  }
  origin: FabricType
}
