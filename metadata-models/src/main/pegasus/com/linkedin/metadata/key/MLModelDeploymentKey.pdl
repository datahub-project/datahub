namespace com.linkedin.metadata.key

import com.linkedin.common.Urn
import com.linkedin.common.FabricType

/**
 * Key for an ML model deployment
 */
@Aspect = {
  "name": "mlModelDeploymentKey",
  "schemaVersion": 2
}
record MLModelDeploymentKey {
  /**
  * Standardized platform urn for the model Deployment
  */
  @Searchable = {
    "fieldType": "URN",
    "queryByDefault": false,
    "enableAutocomplete": true,
    "v3": {
      "searchLabel": "platform",
      "copyToOther": true
    }
  }
  platform: Urn

  /**
  * Name of the MLModelDeployment
  */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
  * Fabric type where model Deployment belongs to or where it was generated
  */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "addToFilters": true,
    "filterNameOverride": "Environment",
    "queryByDefault": false,
    "v3": {
      "searchLabel": "origin",
      "queryByDefault": false,
      "mappings": [
        { "type": "KEYWORD" }
      ]
    }
  }
  origin: FabricType
}
