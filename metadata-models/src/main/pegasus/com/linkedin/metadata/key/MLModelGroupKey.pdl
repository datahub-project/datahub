namespace com.linkedin.metadata.key

import com.linkedin.common.Urn
import com.linkedin.common.FabricType

/**
 * Key for an ML model group
 */
@Aspect = {
  "name": "mlModelGroupKey",
  "schemaVersion": 2
}
record MLModelGroupKey {
  /**
  * Standardized platform urn for the model group
  */
  @Searchable = {
    "fieldType": "URN",
    "queryByDefault": false,
    "enableAutocomplete": true,
    "v3": {
      "searchLabel": "platform",
      "copyToOther": true
    }
  }
  platform: Urn

  /**
  * Name of the MLModelGroup
  */
  @Searchable = {
    "fieldName": "id",
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
  * Fabric type where model group belongs to or where it was generated
  */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "queryByDefault": false,
    "v3": {
      "searchLabel": "origin",
      "queryByDefault": false,
      "mappings": [
        { "type": "KEYWORD" }
      ]
    }
  }
  origin: FabricType
}
