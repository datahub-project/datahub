namespace com.linkedin.metadata.query

import com.linkedin.common.Urn
import com.linkedin.search.template.HighlightFieldOverrides

/**
 * Set of flags to control search behavior
 */
record SearchFlags {
  /**
   * Whether to skip cache
   */
  skipCache: boolean = false

  /**
   * The maximum number of values in a facet aggregation
   */
  maxAggValues: int = 20

  /**
   * Structured or unstructured fulltext query
   */
  fulltext:optional boolean

  /**
   * Whether to skip highlighting
   */
  skipHighlighting:optional boolean = false

  /**
   * Whether to skip aggregates/facets
   */
  skipAggregates:optional boolean = false

  /**
   * Whether to request for search suggestions on the _entityName virtualized field
   */
  getSuggestions:optional boolean = false

  /**
  * Instructions for grouping results before returning
  */
  groupingSpec: optional GroupingSpec

  /**
   * include soft deleted entities in results
   */
   includeSoftDeleted:optional boolean = false

  /**
   * Include entities in lifecycle stages that have hideInSearch=true.
   * By default, entities in hidden lifecycle stages are excluded from search results.
   * Set to true for eval queries or admin tooling that needs to discover all entities
   * regardless of lifecycle stage settings.
   */
   includeHiddenLifecycleStages:optional boolean = false

  /**
   * include restricted entities in results (default is to filter)
   */
   includeRestricted:optional boolean = false

  /**
   * Include mentioned fields inside elastic highlighting query
   */
   customHighlightingFields:optional array[string]

  /**
   * Search V3 adjustment of the template highlight set for one request.
   * {@code replace} cannot be combined with {@code add} or {@code remove}. An explicitly
   * present empty value clears the template set. {@code customHighlightingFields} replaces
   * the set instead of adjusting it. {@code skipHighlighting} clears the result.
   */
   highlightFields: optional HighlightFieldOverrides

  /**
   * Elasticsearch _source include names copied onto SearchEntity.extraFields (Java / Rest.li
   * only — not a GraphQL SearchFlags input). Nested paths and wildcards are passed through to
   * fetch_source; extraFields copies exact top-level _source keys. Empty or absent fetches no
   * extra document fields — only the default urn include.
   */
   fetchExtraFields:optional array[string]

  /**
   * invoke query rewrite chain for filters based on configured rewriters
   */
   rewriteQuery: optional boolean = true

   /**
    * Include default facets when getting facets to aggregate on in search requests.
    * By default we include these, but custom aggregation requests don't need them.
    */
  includeDefaultFacets: optional boolean = true

  /**
   * Include only latest versions in version sets, default true
   */
   filterNonLatestVersions: optional boolean = true

   /**
    * Which fieldConfiguration should be applied. The possible values
    * are defined in the configuration file `search_config.yaml`
    */
    fieldConfiguration:optional string

  /**
    * Sets slice parameter for elasticsearch query,
    * to allow multiple clients to scroll the same query at once.
    * Only supported by the ElasticSearchService
    */
  sliceOptions: optional record SliceOptions {
    id: int
    max: int
  }

  /**
   * Include Elasticsearch scoring explanation in search results.
   * When enabled, each result includes detailed score breakdown in extraProperties._explain.
   * Note: Adds 10-30% computational overhead - use for debugging only.
   */
  includeExplain: optional boolean = false

  /**
   * Elasticsearch search type for controlling IDF calculation across shards.
   * - QUERY_THEN_FETCH: Shard-local IDF (default, faster, but less accurate scoring)
   * - DFS_QUERY_THEN_FETCH: Global IDF across all shards (more accurate scoring)
   *
   * Only affects relevance scoring in multi-shard scenarios.
   * DFS mode adds 20-50% latency overhead but provides consistent scoring.
   */
  searchType: optional string = "QUERY_THEN_FETCH"

  /**
   * Deprecated. Minimum engine kNN score (inclusive). On the cosine engines that hybrid read
   * allows, the engine score is (1 + cosine) / 2, a normalized value from 0 to 1.
   *
   * On semantic search, a hit below this score is dropped, letting an agent abstain instead of
   * returning weak matches. On document rerank, a row below it is not blended and keeps its
   * keyword position; the row is not dropped. When null/unset, no floor is applied. Search
   * templates add retrieval.minSimilarity, a raw cosine, on the vector leg and knn.blendFloor on
   * rerank. Until this flag is removed, a hit or row must pass both it and those controls.
   */
  minScore: optional float

  /**
   * Raw cosine floor, from -1 to 1, on the hits a vector rung (retrieval.combine: vector)
   * retrieves. A hit below it is dropped and a hit at it is kept; the window is not refilled.
   * With no floor in effect it sets one. With retrieval.minSimilarity, or else
   * semanticSearch.minSimilarity, in effect it can only raise it: the higher of the two applies.
   * A profile whose metric is not cosine rejects it. Only a vector rung reads it, as on semantic
   * search through the semantic search template. Semantic search on its legacy path rejects it.
   */
  minSimilarity: optional float

  /**
   * On GraphQL, semantic search through the semantic search template, and searchAcrossEntities and
   * search through a template named in searchTemplate, such as semantic, answer a query they could
   * not embed with an error naming why: timeout, rejected, reserveExhausted, budgetExhausted, or
   * failed. With this flag set they serve keyword search results for the same request instead,
   * without the named template, and SearchResultMetadata.keywordFallback marks them with that
   * reason. Those results cover every requested entity type, not only the ones semantic search
   * covers. Only a failed query embedding falls back: a failed kNN or facet request, and
   * similarity, still fail. Semantic search on its legacy path fails as it does without the flag.
   */
  keywordFallbackOnEmbeddingFailure: optional boolean = false

  /**
   * Caller-selected search template URN. When set, selection skips classification, sub-intent,
   * and engine lookup. The resolved template is not written back onto this field.
   */
  searchTemplate: optional Urn
}
