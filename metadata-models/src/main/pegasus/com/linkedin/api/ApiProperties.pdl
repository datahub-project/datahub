namespace com.linkedin.api

import com.linkedin.common.AuditStamp
import com.linkedin.common.Urn

/**
 * Properties of an API — a named callable with a typed input and output schema
 * (an MCP tool, REST endpoint, gRPC method, GraphQL operation, function, etc.).
 * APIs are cataloged as first-class entities so both humans and agents can
 * discover them before building new ones, and so caller -> API dependencies
 * (services that compose APIs, agents that invoke them) are visible in the
 * graph. The kind of API is captured via the standard subTypes aspect, and the
 * input/output schema lives on the separate apiSignature aspect.
 */
@Aspect = {
  "name": "apiProperties"
}
record ApiProperties {
  /**
   * Display name of the API.
   */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Description of what the API does and when to use it.
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * Optional link to the API's registry entry, documentation, or source.
   */
  externalUrl: optional string

  /**
   * The source-code repository this API is produced from (the SourcedFrom
   * provenance edge). Lights up the repo -> service -> api -> app -> dataset chain.
   */
  @Relationship = {
    "name": "SourcedFrom",
    "entityTypes": [ "repository" ],
    "isLineage": true,
    "isUpstream": true
  }
  @Searchable = {
    "fieldName": "sourceRepository",
    "fieldType": "URN",
    "queryByDefault": false
  }
  sourceRepository: optional Urn

  /**
   * When this API was registered.
   * Search V3 does not index this time. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
      "fieldName": "createdAt",
      "fieldType": "DATETIME",
      "queryByDefault": false,
      "v3": { "enabled": false }
    }
  }
  created: optional AuditStamp

  /**
   * When this API was last modified.
   * Search V3 does not index this time. The write is systemMetadata.aspectModified,
   * copied to _system.modified.time.
   */
  @deprecated = "Use systemMetadata.aspectModified instead."
  @Searchable = {
    "/time": {
      "fieldName": "lastModifiedAt",
      "fieldType": "DATETIME",
      "queryByDefault": false,
      "v3": { "enabled": false }
    }
  }
  lastModified: optional AuditStamp
}
