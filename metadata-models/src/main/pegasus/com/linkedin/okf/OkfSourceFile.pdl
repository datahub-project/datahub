namespace com.linkedin.okf

/** Git provenance of an OKF concept. */
record OkfSourceFile {
  /** Repository in owner/name form. */
  repo: string

  /** File path relative to the repository root. */
  path: string

  /** Branch or ref used to read the file. */
  ref: optional string

  /** Commit SHA for the imported revision, when available. */
  commit: optional string

  /** Git blob SHA for the imported file, when available. */
  blobSha: optional string
}
