namespace com.linkedin.ml.metadata
import com.linkedin.common.Urn
import com.linkedin.common.Edge


/**
* A set of re-usable fields used to capture lineage information for ML Models and ML Model Groups
*/
record MLModelLineageInfo {

    /**
    * List of jobs or process instances (if any) used to train the model or group. Visible in Lineage. Note that ML Models can also be specified as the output of a specific Data Process Instances (runs) via the DataProcessInstanceOutputs aspect.
    * Deprecated! Use trainingJobEdges instead.
    */
    @Relationship = {
        "/*": {
        "name": "TrainedBy",
        "entityTypes": [ "dataJob", "dataProcessInstance" ],
        "isLineage": true
        }
    }
    @deprecated
    trainingJobs: optional array[Urn]

    /**
    * Jobs or process instances (if any) used to train the model or group.
    */
    @Relationship = {
        "/*/destinationUrn": {
        "name": "TrainedBy",
        "entityTypes": [ "dataJob", "dataProcessInstance" ],
        "isLineage": true,
        "createdOn": "trainingJobEdges/*/created/time"
        "createdActor": "trainingJobEdges/*/created/actor"
        "updatedOn": "trainingJobEdges/*/lastModified/time"
        "updatedActor": "trainingJobEdges/*/lastModified/actor"
        "properties": "trainingJobEdges/*/properties"
        }
    }
    trainingJobEdges: optional array[Edge]

    /**
    * List of jobs or process instances (if any) that use the model or group.
    * Deprecated! Use downstreamJobEdges instead.
    */
    @Relationship = {
        "/*": {
        "name": "UsedBy",
        "entityTypes": [ "dataJob", "dataProcessInstance" ],
        "isLineage": true,
        "isUpstream": false
        }
    }
    @deprecated
    downstreamJobs: optional array[Urn]

    /**
    * Jobs or process instances (if any) that use the model or group.
    */
    @Relationship = {
        "/*/destinationUrn": {
        "name": "UsedBy",
        "entityTypes": [ "dataJob", "dataProcessInstance" ],
        "isLineage": true,
        "isUpstream": false,
        "createdOn": "downstreamJobEdges/*/created/time"
        "createdActor": "downstreamJobEdges/*/created/actor"
        "updatedOn": "downstreamJobEdges/*/lastModified/time"
        "updatedActor": "downstreamJobEdges/*/lastModified/actor"
        "properties": "downstreamJobEdges/*/properties"
        }
    }
    downstreamJobEdges: optional array[Edge]

}