namespace com.linkedin.knowledge

/**
 * OKF concept metadata imported from a document's frontmatter.
 */
@Aspect = {
  "name": "okfProperties"
}
record OkfProperties {
  /** Version of the OKF format declared by the concept. */
  okfVersion: optional string

  /** Stable concept identifier within the source repository. */
  @Searchable = {
    "fieldName": "okfId",
    "fieldType": "KEYWORD",
    "queryByDefault": true
  }
  id: optional string

  /** Concept type, such as Guide, Table, Policy, or Runbook. */
  @Searchable = {
    "fieldName": "okfType",
    "fieldType": "KEYWORD",
    "addToFilters": true,
    "queryByDefault": false
  }
  type: string

  /** Description declared in frontmatter. */
  description: optional string

  /** All frontmatter keys and values serialized as JSON, including unmapped keys. */
  frontmatter: string

  /** Original YAML block, including delimiters and line endings, verbatim. */
  raw: optional string

  /** Git provenance of the imported concept. */
  sourceFile: optional OkfSourceFile

  /** Version of the rules used to map frontmatter to native metadata. */
  mappingVersion: string
}
