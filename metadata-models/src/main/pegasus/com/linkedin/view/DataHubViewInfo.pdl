namespace com.linkedin.view

import com.linkedin.metadata.query.filter.Filter
import com.linkedin.common.Urn
import com.linkedin.common.AuditStamp

/**
 * Information about a DataHub View. -- TODO: Understand whether an entity type filter is required.
 */
@Aspect = {
  "name": "dataHubViewInfo",
  "schemaVersion": 3
}
record DataHubViewInfo {
  /**
   * The name of the View
   */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "boostScore": 10.0,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Description of the view
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * The type of View
   */
  @Searchable = {
    "v3": {
      "queryByDefault": true
    }
  }
  type: enum DataHubViewType {
    /**
     * A view private for a specific person.
     */
    PERSONAL

    /**
     * A global view, which all users can see and use.
     */
     GLOBAL
  }

  /**
   * The view itself
   */
  definition: DataHubViewDefinition

  /**
   * Audit stamp capturing the time and actor who created the View.
   * Search V3 does not index this stamp. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time and _system.created.actor.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
       "fieldType": "DATETIME",
       "fieldName": "createdAt",
       "v3": { "enabled": false }
    },
    "/actor": {
      "fieldType": "URN",
      "fieldName": "createdBy",
      "v3": { "enabled": false }
    }
  }
  created: AuditStamp

  /**
   * Audit stamp capturing the time and actor who last modified the View.
   * Search V3 does not index this time. The write is systemMetadata.aspectModified,
   * copied to _system.modified.time.
   */
  @deprecated = "Use systemMetadata.aspectModified instead."
  @Searchable = {
    "/time": {
       "fieldType": "DATETIME",
       "fieldName": "lastModifiedAt",
       "v3": { "enabled": false }
    }
  }
  lastModified: AuditStamp
}