namespace com.linkedin.datatype

@Aspect = {
    "name": "dataTypeInfo",
    "schemaVersion": 2
}
record DataTypeInfo {
    /**
     * The qualified name for the data type. Usually a unique namespace + name, e.g. datahub.string
     */
    @Searchable = {
      "fieldType": "KEYWORD",
      "queryByDefault": true,
      "boostScore": 10.0,
      "v3": {
        "queryByDefault": true,
        "searchLabel": "qualifiedName",
        "lowercase": true,
        "mappings": [
          { "type": "KEYWORD" },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    qualifiedName: string

    /**
     * An optional display name for the data type.
     */
    @Searchable = {
      "fieldType": "WORD_GRAM",
      "boostScore": 10.0,
      "v3": {
        "queryByDefault": true,
        "searchLabel": "name",
        "lowercase": true,
        "mappings": [
          { "type": "KEYWORD" },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    displayName: optional string

    /**
     * An optional description for the data type.
     */
    @Searchable = {
      "fieldType": "TEXT",
      "hasValuesFieldName": "hasDescription",
      "v3": {
        "queryByDefault": true,
        "searchLabel": "description",
        "mappings": [
          { "type": "KEYWORD", "index": false, "docValues": false },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    description: optional string
}
