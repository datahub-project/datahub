namespace com.linkedin.datatype

@Aspect = {
    "name": "dataTypeInfo"
}
record DataTypeInfo {
    /**
     * The qualified name for the data type. Usually a unique namespace + name, e.g. datahub.string
     */
    @Searchable = {
      "fieldType": "KEYWORD",
      "boostScore": 10.0,
      "v3": {
        "searchLabel": "qualifiedName",
        "mappings": [
          { "type": "KEYWORD" },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    qualifiedName: string

    /**
     * An optional display name for the data type.
     */
    displayName: optional string

    /**
     * An optional description for the data type.
     */
    description: optional string
}
