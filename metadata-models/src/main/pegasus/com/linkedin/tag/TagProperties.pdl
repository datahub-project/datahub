namespace com.linkedin.tag

/**
 * Properties associated with a Tag
 */
@Aspect = {
  "name": "tagProperties"
}
record TagProperties {
  /**
   * Display name of the tag
   */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Documentation of the tag
   */
  @Searchable = {
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * The color associated with the Tag in Hex. For example #FFFFFF.
   */
  colorHex: optional string
}
