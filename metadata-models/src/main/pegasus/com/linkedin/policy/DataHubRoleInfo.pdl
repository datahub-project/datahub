namespace com.linkedin.policy

import com.linkedin.common.Urn

/**
 * Information about a DataHub Role.
 */
@Aspect = {
  "name": "dataHubRoleInfo"
}
record DataHubRoleInfo {
  /**
   * Name of the Role
   */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "boostScore": 10.0,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Description of the Role
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: string

  /**
   * Whether the role should be editable via the UI
   */
  editable: boolean = false
}