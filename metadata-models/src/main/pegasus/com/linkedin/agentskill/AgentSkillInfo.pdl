namespace com.linkedin.agentskill

import com.linkedin.common.AuditStamp
import com.linkedin.common.Urn

/**
 * Properties of an AgentSkill — a high-level capability bundle (specialized
 * prompts/instructions + the tools it relies on). Skills are
 * higher-level than tools: a skill packages domain expertise and the
 * low-level tools needed to apply it.
 */
@Aspect = {
  "name": "agentSkillInfo"
}
record AgentSkillInfo {
  /**
   * Display name of the skill.
   */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Description of what the skill does and when to use it.
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * Markdown body of the skill's SKILL.md file, excluding YAML frontmatter.
   * This is the execution guidance loaded when the skill is activated.
   */
  instructions: optional string

  /**
   * Git location where the skill is defined (source of truth).
   */
  sourceRepository: optional SkillSourceRepository

  /**
   * Tools this skill requires to operate.
   */
  @Relationship = {
    "/*": {
      "name": "SkillRequiresTool",
      "entityTypes": [ "api" ]
    }
  }
  @Searchable = {
    "/*": {
      "fieldName": "requiredTools",
      "fieldType": "URN",
      "queryByDefault": false
    }
  }
  requiredTools: optional array[Urn]

  /**
   * When this skill was registered.
   * Search V3 does not index this time. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
      "fieldName": "createdAt",
      "fieldType": "DATETIME",
      "queryByDefault": false,
      "v3": { "enabled": false }
    }
  }
  created: optional AuditStamp

  /**
   * When this skill was last modified.
   * Search V3 does not index this time. The write is systemMetadata.aspectModified,
   * copied to _system.modified.time.
   */
  @deprecated = "Use systemMetadata.aspectModified instead."
  @Searchable = {
    "/time": {
      "fieldName": "lastModifiedAt",
      "fieldType": "DATETIME",
      "queryByDefault": false,
      "v3": { "enabled": false }
    }
  }
  lastModified: optional AuditStamp
}
