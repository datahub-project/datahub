namespace com.linkedin.dataproduct
import com.linkedin.common.CustomProperties
import com.linkedin.common.ExternalReference
import com.linkedin.common.Urn

/**
 * The main properties of a Data Product
 */
@Aspect = {
  "name": "dataProductProperties",
  "schemaVersion": 3
}
record DataProductProperties includes CustomProperties, ExternalReference  {
  /**
   * Display name of the Data Product
   */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "fieldNameAliases": [ "_entityName" ],
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: optional string

  /**
   * Documentation of the data product
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "sanitizeRichText": true,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * A list of assets that are part of this Data Product
   */
  @Relationship = {
    "/*/destinationUrn": {
      "name": "DataProductContains",
      "entityTypes": [ "dataset", "dataJob", "dataFlow", "chart", "dashboard", "notebook", "container", "mlModel", "mlModelGroup", "mlFeatureTable", "mlFeature", "mlPrimaryKey", "document", "api" ],
    }
  }
  assets: optional array[DataProductAssociation]

  /**
   * Optional: parent Data Product, forming a parent-child taxonomy.
   */
  @Relationship = {
    "name": "IsPartOf",
    "entityTypes": [ "dataProduct" ],
  }
  @Searchable = {
    "fieldName": "parentDataProduct",
    "fieldType": "URN",
    "hasValuesFieldName": "hasParentDataProduct",
    "v3": {
      "copyToOther": true
    }
  }
  parentDataProduct: optional Urn
}
