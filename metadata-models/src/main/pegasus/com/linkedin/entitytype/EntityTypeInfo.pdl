namespace com.linkedin.entitytype

@Aspect = {
    "name": "entityTypeInfo",
    "schemaVersion": 2
}
record EntityTypeInfo {
    /**
     * The fully qualified name for the entity type, which usually consists of a namespace
     * plus an identifier or name, e.g. datahub.dataset
     */
    @Searchable = {
      "fieldType": "KEYWORD",
      "queryByDefault": true,
      "boostScore": 10.0,
      "v3": {
        "searchLabel": "qualifiedName",
        "mappings": [
          { "type": "KEYWORD" },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    qualifiedName: string

    /**
     * The display name for the Entity Type.
     */
    @Searchable = {
      "fieldType": "WORD_GRAM",
      "boostScore": 10.0,
      "v3": {
        "searchLabel": "name",
        "mappings": [
          { "type": "KEYWORD" },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    displayName: optional string

    /**
     * A description for the Entity Type: what is it for?
     */
    @Searchable = {
      "fieldType": "TEXT",
      "hasValuesFieldName": "hasDescription",
      "v3": {
        "searchLabel": "description",
        "mappings": [
          { "type": "KEYWORD", "index": false, "docValues": false },
          { "subfield": "text", "type": "TEXT" },
          { "subfield": "stemmed", "type": "STEMMED" }
        ]
      }
    }
    description: optional string
}
