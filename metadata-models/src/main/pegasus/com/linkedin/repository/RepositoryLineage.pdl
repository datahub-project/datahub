namespace com.linkedin.repository

import com.linkedin.common.Edge
import com.linkedin.common.Urn

/**
 * Provenance edges to/from a Repository's source code. Originally Repository-only
 * (forkOf, plus what the repo's own code reads/writes); also registered on
 * dataJob/dataFlow so a pipeline or task can link directly to the Repository
 * holding its source code, and have that edge participate in the lineage graph
 * like any other lineage-flagged relationship.
 */
@Aspect = {
  "name": "repositoryLineage"
}
record RepositoryLineage {

  /**
   * The repository this one is a git fork of. A plain provenance edge.
   * Repository-only -- always unset on dataJob/dataFlow.
   */
  @Relationship = {
    "name": "RepositoryForkOf",
    "entityTypes": [ "repository" ],
    "isLineage": true,
    "isUpstream": true
  }
  forkOf: optional Urn

  /**
   * Upstream entities this entity's code depends on. On Repository: datasets/
   * repositories the repo's own code reads from. On dataJob/dataFlow: the
   * Repository holding the pipeline/task's source code, and/or
   * other upstream datasets analogous to Repository's own usage. Follows the
   * same Edge-based pattern as ApplicationLineage.inputEdges.
   */
  @Relationship = {
    "/*/destinationUrn": {
      "name": "RepositoryConsumes",
      "entityTypes": [ "dataset", "repository" ],
      "isLineage": true,
      "isUpstream": true,
      "createdOn": "inputEdges/*/created/time",
      "createdActor": "inputEdges/*/created/actor",
      "updatedOn": "inputEdges/*/lastModified/time",
      "updatedActor": "inputEdges/*/lastModified/actor",
      "properties": "inputEdges/*/properties"
    }
  }
  @Searchable = {
    "/*/destinationUrn": {
      "fieldName": "inputEdges",
      "fieldType": "URN",
      "queryByDefault": false
    }
  }
  inputEdges: optional array[Edge]

  /**
   * Downstream entities produced or written by this entity's code. On
   * Repository: datasets/repositories the repo's own code writes to. Expected
   * to stay empty in practice on dataJob/dataFlow -- a source-code repository
   * is a dependency (inputEdges), not an output -- but not restricted at the
   * schema level. Follows the same Edge-based pattern as
   * ApplicationLineage.outputEdges.
   */
  @Relationship = {
    "/*/destinationUrn": {
      "name": "RepositoryProduces",
      "entityTypes": [ "dataset", "repository" ],
      "isUpstream": false,
      "isLineage": true,
      "createdOn": "outputEdges/*/created/time",
      "createdActor": "outputEdges/*/created/actor",
      "updatedOn": "outputEdges/*/lastModified/time",
      "updatedActor": "outputEdges/*/lastModified/actor",
      "properties": "outputEdges/*/properties"
    }
  }
  @Searchable = {
    "/*/destinationUrn": {
      "fieldName": "outputEdges",
      "fieldType": "URN",
      "queryByDefault": false
    }
  }
  outputEdges: optional array[Edge]
}
