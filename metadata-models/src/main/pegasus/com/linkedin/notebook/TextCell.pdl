namespace com.linkedin.notebook

/**
 * Text cell in a Notebook, which will present content in text format
 */
record TextCell includes CommonCellAttributes {
  /**
   * The actual text in a TextCell in a Notebook
   */
  @Searchable = {
    "fieldType": "RICH_TEXT",
    "queryByDefault": false,
    "v3": {
      "queryByDefault": true,
      "boostScore": 1.0,
      "searchLabel": "text",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  text: string
}
