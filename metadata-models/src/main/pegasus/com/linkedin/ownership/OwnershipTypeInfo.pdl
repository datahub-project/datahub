namespace com.linkedin.ownership

import com.linkedin.common.AuditStamp

/**
 * Information about an ownership type
 */
@Aspect = {
  "name": "ownershipTypeInfo",
  "schemaVersion": 2
}
record OwnershipTypeInfo {

  /**
   * Display name of the Ownership Type
   */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "enableAutocomplete": true,
    "boostScore": 10.0,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  name: string

  /**
   * Description of the Ownership Type
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

   /**
    * Audit stamp capturing the time and actor who created the Ownership Type.
    * Search V3 does not index this stamp. The write is systemMetadata.aspectCreated,
    * copied to _system.created.time and _system.created.actor.
    */
   @deprecated = "Use systemMetadata.aspectCreated instead."
   @Searchable = {
     "/time": {
        "fieldType": "DATETIME",
        "fieldName": "createdAt",
        "v3": { "enabled": false }
     },
     "/actor": {
       "fieldType": "URN",
       "fieldName": "createdBy",
       "v3": { "enabled": false }
     }
   }
   created: AuditStamp

   /**
    * Audit stamp capturing the time and actor who last modified the Ownership Type.
    * Search V3 does not index this stamp. The write is systemMetadata.aspectModified,
    * copied to _system.modified.time and _system.modified.actor.
    */
   @deprecated = "Use systemMetadata.aspectModified instead."
   @Searchable = {
     "/time": {
        "fieldType": "DATETIME",
        "fieldName": "lastModifiedAt",
        "v3": { "enabled": false }
     }
     "/actor": {
       "fieldType": "URN",
       "fieldName": "lastModifiedBy",
       "v3": { "enabled": false }
     }
   }
   lastModified: AuditStamp
}
