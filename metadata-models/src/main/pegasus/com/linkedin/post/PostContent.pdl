namespace com.linkedin.post

import com.linkedin.common.Media
import com.linkedin.common.Url

/**
 * Content stored inside a Post.
 */
record PostContent {
  /**
   * Title of the post.
   */
  @Searchable = {
    "fieldType": "TEXT_PARTIAL",
    "boostScore": 10.0,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  title: string

  /**
   * Type of content held in the post.
   */
  type: PostContentType

  /**
   * Optional description of the post.
   */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * Optional link that the post is associated with.
   */
  link: optional Url

  /**
   * Optional media that the post is storing
   */
  media: optional Media
}