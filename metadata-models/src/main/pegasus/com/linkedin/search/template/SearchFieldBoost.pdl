namespace com.linkedin.search.template

/**
 * A queried field and its boost, used by a search template's field overrides.
 */
record SearchFieldBoost {
  /**
   * Indexed field name, or a structured-property definition URN. A subfield is separate.
   * A member contribution is the shared field plus {@code .member}, such as {@code tags.member}
   * for tags that live on a dataset's columns. {@code tags} is the direct contribution, the
   * value on the entity itself. Each contribution has its own boost.
   */
  fieldName: string

  /**
   * Boost applied to this field. Matches {@code boostScore} on {@code @Searchable}.
   */
  boost: double

  /**
   * Subfield appended after a structured-property field. The only value is {@code keyword}.
   * The query body names {@code .keyword} or {@code .text}.
   */
  subfield: optional string
}
