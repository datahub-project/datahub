namespace com.linkedin.incident

import com.linkedin.common.AuditStamp
import com.linkedin.common.EntityReference
import com.linkedin.common.Time
import com.linkedin.common.Urn

/**
 * Information about an incident raised on an asset.
 *
 * NOTE: When this file is changed, update IncidentActivityEvent.pdl to remove searchable and relationship annotations.
 */
@Aspect = {
  "name": "incidentInfo",
  "schemaVersion": 4
}
record IncidentInfo {
  /**
  * The type of incident
  */
  @Searchable = {
    "v3": {
      "queryByDefault": true
    },
    "addToFilters": true,
    "filterNameOverride": "Type"
  }
  type: IncidentType

  /**
  * An optional custom incident type. Present only if type is 'CUSTOM'.
  */
  @Searchable = {
    "v3": {
      "queryByDefault": true
    },
    "addToFilters": true,
    "filterNameOverride": "Other Type"
  }
  customType: optional string

  /**
  * Optional title associated with the incident
  */
  @Searchable = {
    "fieldType": "WORD_GRAM",
    "boostScore": 10.0,
    "v3": {
      "queryByDefault": true,
      "searchLabel": "name",
      "lowercase": true,
      "mappings": [
        { "type": "KEYWORD" },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  title: optional string

  /**
  * Optional description associated with the incident
  */
  @Searchable = {
    "fieldType": "TEXT",
    "hasValuesFieldName": "hasDescription",
    "v3": {
      "queryByDefault": true,
      "searchLabel": "description",
      "mappings": [
        { "type": "KEYWORD", "index": false, "docValues": false },
        { "subfield": "text", "type": "TEXT" },
        { "subfield": "stemmed", "type": "STEMMED" }
      ]
    }
  }
  description: optional string

  /**
   * A reference to the entity associated with the incident.
   */
  @Relationship = {
    "/*": {
      "name": "IncidentOn",
      "entityTypes": [ "dataset", "chart", "dashboard", "dataFlow", "dataJob", "schemaField", "mlModel", "mlFeature", "mlFeatureTable", "service", "aiAgent"]
    }
  }
  @Searchable = {
    "/*": {
      "v3": {
        "queryByDefault": true
      },
      "fieldType": "URN"
    }
  }
  entities: array[Urn]

  /**
  * A numeric severity or priority for the incident. On the UI we will translate this into something easy to understand.
  * Currently supported: 0 - CRITICAL, 1 - HIGH, 2 - MED, 3 - LOW
  * (We probably should have modeled as an enum)
  */
  @Searchable = {
    "addToFilters": true,
    "filterNameOverride": "Priority"
  }
  priority: optional int

  /**
   * The parties assigned with resolving the incident
   */
  assignees: optional array[IncidentAssignee]

  /**
   * The current status of an incident, i.e. active or inactive.
   */
  status: IncidentStatus

  /**
   * The source of an incident, i.e. how it was generated.
   */
  source: optional IncidentSource

  /**
   * The time at which the incident actually started (may be before the date it was raised).
   * Time is a long typeref, so the /time path does not resolve. Search reads the top-level
   * v3 flag, which keeps this field in the unqualified query.
   */
  @Searchable = {
    "/time": {
        "fieldName": "startedAt",
        "fieldType": "DATETIME",
        "v3": {
          "searchLabel": "sourceCreatedAt",
          "mappings": [
            { "type": "DATETIME" }
          ]
        }
      },
    "v3": {
      "queryByDefault": true
    }
  }
  startedAt: optional Time

  /**
   * When this incident was raised in DataHub.
   * Search V3 does not index this stamp. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time and _system.created.actor.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
        "fieldName": "created",
        "fieldType": "DATETIME",
        "v3": { "enabled": false }
      }
  }
  created: AuditStamp
}