namespace com.linkedin.module

import com.linkedin.common.AuditStamp

/**
 * The main properties of a DataHub page module
 */
@Aspect = {
  "name": "dataHubPageModuleProperties",
  "schemaVersion": 3
}
record DataHubPageModuleProperties  {
  /**
   * The display name of this module
   */
  name: string

  /**
   * The type of this module - the purpose it serves
   */
  @Searchable = {
    "fieldType": "KEYWORD"
  }
  type: DataHubPageModuleType
  
  /**
   * Info about the visibility of this module
   */
  visibility: DataHubPageModuleVisibility

  /**
   * The specific parameters stored for this module
   */
  params: DataHubPageModuleParams

  /**
   * Audit stamp for when and by whom this module was created.
   * Search V3 does not index this stamp. The write is systemMetadata.aspectCreated,
   * copied to _system.created.time and _system.created.actor.
   */
  @deprecated = "Use systemMetadata.aspectCreated instead."
  @Searchable = {
    "/time": {
       "fieldType": "DATETIME",
       "fieldName": "createdAt",
       "v3": { "enabled": false }
    },
    "/actor": {
      "fieldType": "URN",
      "fieldName": "createdBy",
      "v3": { "enabled": false }
    }
  }
  created: AuditStamp
  
  /**
   * Audit stamp for when and by whom this module was last updated.
   * Search V3 does not index this time. The write is systemMetadata.aspectModified,
   * copied to _system.modified.time.
   */
  @deprecated = "Use systemMetadata.aspectModified instead."
  @Searchable = {
    "/time": {
       "fieldType": "DATETIME",
       "fieldName": "lastModifiedAt",
       "v3": { "enabled": false }
    }
  }
  lastModified: AuditStamp
}
