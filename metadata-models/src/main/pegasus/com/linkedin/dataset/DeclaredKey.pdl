namespace com.linkedin.dataset

/**
 * A named key made of one or more fields of a dataset.
 */
record DeclaredKey {
  /**
   * Name of the key, unique within the dataset.
   */
  name: string

  /**
   * Field paths of the fields the key is made of.
   */
  fields: array[string]

  /**
   * Description of the key.
   */
  description: optional string
}
