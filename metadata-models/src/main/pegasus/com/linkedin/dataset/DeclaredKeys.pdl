namespace com.linkedin.dataset

import com.linkedin.common.AuditStamp

/**
 * Keys of a dataset declared by users rather than by its source. Useful for datasets whose source
 * declares no key constraints (files, object stores, lake tables, warehouse tables without
 * constraints).
 *
 * Kept separate from the ingestion-owned schemaMetadata aspect so ingestion runs never overwrite
 * it. A primary key declared by the source (schemaMetadata.primaryKeys or SchemaField.isPartOfKey)
 * always takes precedence over the declared primary key.
 */
@Aspect = {
  "name": "declaredKeys"
}
record DeclaredKeys {
  /**
   * Field paths of the declared primary key. Only becomes the effective primary key when the
   * source declares none.
   */
  primaryKey: optional array[string]

  /**
   * Named business (logical) keys. These never compete with the physical primary key.
   */
  businessKeys: optional array[DeclaredKey]

  /**
   * Audit stamp of when the keys were first declared.
   */
  created: optional AuditStamp

  /**
   * Audit stamp of the last change to the declared keys.
   */
  lastModified: optional AuditStamp
}
