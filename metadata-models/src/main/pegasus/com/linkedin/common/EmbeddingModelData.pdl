namespace com.linkedin.common

/**
 * Embedding data for a specific model.
 * Contains metadata about the embedding generation and the chunked vectors.
 */
record EmbeddingModelData {

  /**
   * Full model identifier including provider.
   * Examples: bedrock/cohere.embed-english-v3, openai/text-embedding-ada-002
   */
  modelVersion: string

  /**
   * Timestamp when embeddings were generated (milliseconds since epoch).
   */
  generatedAt: long

  /**
   * SHA-256 hex digest over the UTF-8 bytes of the exact resolved source text these embeddings
   * were generated from (the semanticText override when set, else the entity's body text).
   * Written by the embedding pipeline at generation time so consumers (e.g. coverage reporting)
   * can detect genuinely stale embeddings by comparing against a hash of the current resolved
   * text, instead of relying on modification timestamps that move on non-content writes.
   */
  sourceTextSha256: optional string

  /**
   * Description of the chunking strategy used.
   * Examples: sentence_boundary_400t, fixed_512_chars, paragraph
   */
  chunkingStrategy: optional string

  /**
   * Total number of chunks.
   */
  totalChunks: int

  /**
   * Estimated total token count across all chunks.
   */
  totalTokens: optional int

  /**
   * Individual chunks with their embedding vectors.
   */
  chunks: array[EmbeddingChunk]

  /**
   * What this profile stores. Absent when the field is missing and there are no chunks.
   * Legacy data with chunks and no value is read as READY.
   */
  vectorState: optional SemanticVectorState

  /**
   * Outstanding work for this profile. Independent of vectorState.
   */
  workState: optional SemanticWorkState

  /**
   * Why the profile is excluded, skipped, deferred, or quarantined.
   */
  stateReason: optional string

  /**
   * Policy version that produced the current vector or work state.
   */
  policyVersion: optional string

  /**
   * True when the stored vectors match the profile's bound content.
   * Unset on legacy data.
   */
  current: optional boolean

  /**
   * The entity refresh marker these vectors represent.
   */
  refreshMarker: optional SemanticRefreshMarker

  /**
   * Set when a content write could not name a version or timestamp.
   * A metadata-service write always has a timestamp, so this stays unset there.
   */
  dirty: optional boolean

  /**
   * True when the chunk cap cut this profile before hashing.
   */
  partial: optional boolean

  /**
   * Hash of the capped chunk payload that was embedded.
   * Distinct from sourceTextSha256, which covers the resolved source text.
   */
  contentHash: optional string

  /**
   * Dimension of the stored vectors.
   */
  vectorDimension: optional int
}
