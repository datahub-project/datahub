<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!-- One test at a time: the Cassandra classes switch the process-wide UnknownDataHandlings, which
     would leak into the Neo4j classes if both ran together. -->
<suite name="metadata-io-cassandra-neo4j" parallel="tests" thread-count="1">
    <test name="cassandra-testcontainers">
        <packages>
            <package name="com.linkedin.metadata.entity.cassandra.*" />
            <package name="com.linkedin.metadata.timeline.cassandra.*"/>
        </packages>
    </test>
    <test name="neo4j-testcontainers">
        <packages>
            <package name="com.linkedin.metadata.graph.neo4j.*" />
        </packages>
    </test>
</suite>
