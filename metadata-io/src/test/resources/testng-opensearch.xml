<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="metadata-io-opensearch" parallel="tests" thread-count="1">
    <test name="opensearch-testcontainers">
        <packages>
            <package name="com.linkedin.metadata.graph.search.opensearch.*" />
            <package name="com.linkedin.metadata.search.opensearch.*"/>
            <package name="com.linkedin.metadata.test.batch.opensearch.*"/>
            <!-- Container-free shim unit tests (mocked RestClient / request converters / arch
                 rules). Historically these ran only via the es8 suite; that leg is unwired while
                 pre-existing failures are burned down, so run them here to keep the unified-shim
                 unit coverage in CI. Es8SemanticSearchIT (excluded in build.gradle) is the one
                 class in these packages that boots its own container. -->
            <package name="com.linkedin.metadata.search.elasticsearch.client.shim"/>
            <package name="com.linkedin.metadata.search.elasticsearch.client.shim.impl"/>
            <package name="com.linkedin.metadata.search.elasticsearch.client.shim.builder.*"/>
            <!-- Container-free in-memory queue store tests. -->
            <package name="com.linkedin.metadata.queue.inmemory"/>
            <!-- Container-free hybrid search unit tests: the other suite, which would run them,
                 is unwired. -->
            <package name="com.linkedin.metadata.search.hybrid"/>
        </packages>
        <classes>
            <!-- Container-free; its package otherwise runs only in the unwired es8 suite. -->
            <class name="com.linkedin.metadata.search.elasticsearch.query.ESSearchDAOHybridTest"/>
            <!-- Container-free (mocked AspectDao / EventProducer / search services) unit tests for
                 entity reads, MCL production, index updates, tracing, rollback and consistency
                 checks, including the unknown entity/aspect tolerance used after a version
                 rollback. Their packages are otherwise only covered by the
                 unwired testOther suite. -->
            <class name="com.linkedin.metadata.entity.EntityServiceImplTest"/>
            <class name="com.linkedin.metadata.entity.EntityUtilsTest"/>
            <class name="com.linkedin.metadata.service.UpdateIndicesServiceTest"/>
            <class name="com.linkedin.metadata.trace.TraceServiceImplTest"/>
            <class name="com.linkedin.metadata.aspect.consistency.ConsistencyServiceTest"/>
            <class name="com.linkedin.metadata.aspect.validation.UrnAnnotationValidatorTest"/>
            <class name="com.linkedin.metadata.aspect.validation.PolicyFieldTypeValidatorTest"/>
            <class name="com.linkedin.metadata.search.SearchServiceUnknownEntityTypeTest"/>
            <!-- Container-free tests of the unknown entity/aspect tolerance (rollback) in consistency
                 checks, side effects, deletes, Cassandra, versioning, index mappings and timeseries.
                 Their packages are otherwise only covered by unwired suites. -->
            <class name="com.linkedin.metadata.aspect.consistency.check.InvalidEnumCheckTest"/>
            <class name="com.linkedin.metadata.dataproducts.sideeffects.DataProductAssetsSideEffectTest"/>
            <class name="com.linkedin.metadata.entity.DeleteEntityServiceTest"/>
            <class name="com.linkedin.metadata.entity.cassandra.CassandraAspectDaoTest"/>
            <class name="com.linkedin.metadata.entity.versioning.validation.VersionPropertiesValidatorTest"/>
            <class name="com.linkedin.metadata.search.indexbuilder.ReindexConfigTest"/>
            <class name="com.linkedin.metadata.structuredproperties.hooks.PropertyDefinitionDeleteSideEffectTest"/>
            <class name="com.linkedin.metadata.timeseries.search.TimeseriesAspectServiceUnitTest"/>
            <class name="com.linkedin.metadata.search.elasticsearch.index.entity.v3.MultiEntityMappingsBuilderTest"/>
            <!-- Ratchet against new getEntitySpec(<urn>.getEntityType()) lookups. -->
            <class name="com.linkedin.metadata.lint.UrnDerivedRegistryLookupLintTest"/>
        </classes>
    </test>
</suite>

