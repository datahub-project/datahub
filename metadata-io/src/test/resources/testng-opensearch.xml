<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="metadata-io-opensearch" parallel="tests" thread-count="1">
    <test name="opensearch-testcontainers">
        <packages>
            <package name="com.linkedin.metadata.graph.search.opensearch.*" />
            <package name="com.linkedin.metadata.search.opensearch.*"/>
            <package name="com.linkedin.metadata.test.batch.opensearch.*"/>
            <!-- Container-free shim unit tests (mocked RestClient / request converters / arch
                 rules). Historically these ran only via the es8 suite; that leg is unwired while
                 pre-existing failures are burned down, so run them here to keep the unified-shim
                 unit coverage in CI. Es8SemanticSearchIT (excluded in build.gradle) is the one
                 class in these packages that boots its own container. -->
            <package name="com.linkedin.metadata.search.elasticsearch.client.shim"/>
            <package name="com.linkedin.metadata.search.elasticsearch.client.shim.impl"/>
            <package name="com.linkedin.metadata.search.elasticsearch.client.shim.builder.*"/>
        </packages>
    </test>
</suite>

