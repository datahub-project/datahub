<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="metadata-io-postgresql" parallel="classes" thread-count="2">
    <test name="postgresql-sqlsetup">
        <packages>
            <package name="com.linkedin.metadata.sqlsetup.postgres.migration"/>
            <package name="com.linkedin.metadata.sqlsetup.postgres.pgqueue"/>
            <package name="com.linkedin.metadata.entity.storage"/>
        </packages>
    </test>
    <!-- Coordinated-ingest concurrency against real PostgreSQL. The MySQL subclass is registered in
         testng-mysql.xml instead; only the Postgres class is listed here so the postgres suite does
         not start a MySQL container. -->
    <test name="postgresql-coordinated-ingest-concurrency">
        <classes>
            <class name="com.linkedin.metadata.entity.coordinator.concurrency.CoordinatedIngestConcurrencyPostgresIT"/>
        </classes>
    </test>
    <test name="postgresql-ebean-locking">
        <classes>
            <class name="com.linkedin.metadata.entity.ebean.EbeanAspectDaoLockingPostgresIT"/>
        </classes>
    </test>
</suite>
