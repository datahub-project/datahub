<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="metadata-io" parallel="classes">
    <test name="nonsearch">
        <packages>
            <package name="com.linkedin.metadata.*">
                <exclude name="com.linkedin.metadata.graph.search.elasticsearch.*" />
                <exclude name="com.linkedin.metadata.search.elasticsearch.*"/>
                <exclude name="com.linkedin.metadata.graph.search.opensearch.*" />
                <exclude name="com.linkedin.metadata.search.opensearch.*"/>
                <exclude name="com.linkedin.metadata.entity.cassandra.*" />
                <exclude name="com.linkedin.metadata.timeline.cassandra.*"/>
                <exclude name="com.linkedin.metadata.graph.neo4j.*"/>
            </package>
            <package name="io.datahubproject.test.aspect.*"/>
        </packages>

        <!-- Explicitly exclude the specific test class -->
        <classes>
            <class name="com.linkedin.metadata.entity.EbeanEntityServiceOptimizationTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <!-- PostgreSQL Testcontainers IT; runs in testng-postgresql.xml, not the default suite -->
            <class name="com.linkedin.metadata.entity.ebean.EbeanAspectDaoLockingPostgresIT">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <!-- MySQL / PostgreSQL OL Testcontainers ITs; run in testng-mysql.xml / testng-postgresql.xml -->
            <class name="com.linkedin.metadata.entity.ebean.optimistic.EbeanOptimisticLockingMysqlIT">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.ebean.optimistic.EbeanOptimisticLockingPostgresIT">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <!-- These switch the process-wide UnknownDataHandlings strategy (TolerantHandling before
                 each test, strict after), which would leak into classes running alongside them here
                 (parallel="classes"). They run one class at a time in testng-opensearch.xml. -->
            <class name="com.linkedin.metadata.aspect.consistency.ConsistencyServiceTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.aspect.consistency.CheckContextTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.aspect.consistency.check.InvalidEnumCheckTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.aspect.validation.PolicyFieldTypeValidatorTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.aspect.validation.UrnAnnotationValidatorTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.dataproducts.sideeffects.DataProductAssetsSideEffectTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.DeleteEntityServiceTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.EntityServiceImplTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.EbeanEntityServiceTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.EntityUtilsTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.retention.buffer.RetentionDrainerTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.entity.versioning.validation.VersionPropertiesValidatorTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.search.SearchServiceUnknownEntityTypeTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.search.indexbuilder.ReindexConfigTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.search.query.ESSearchDAORawEntityTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.service.UpdateGraphIndicesServiceTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.service.UpdateIndicesServiceTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.structuredproperties.hooks.PropertyDefinitionDeleteSideEffectTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.timeseries.search.TimeseriesAspectServiceUnitTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.trace.TraceServiceImplTest">
                <methods>
                    <exclude name=".*" />
                </methods>
            </class>
            <class name="com.linkedin.metadata.search.embedding.LocalEmbeddingProviderTest"/>
            <class name="com.linkedin.metadata.search.embedding.OpenAIEmbeddingProviderTest"/>
            <class name="com.linkedin.metadata.search.embedding.CohereEmbeddingProviderTest"/>
            <class name="com.linkedin.metadata.search.embedding.AwsBedrockEmbeddingProviderTest"/>
            <class name="com.linkedin.metadata.search.embedding.OnnxEmbeddingProviderTest"/>
            <class name="com.linkedin.metadata.search.embedding.ClassicalEmbeddingProviderTest"/>
        </classes>
    </test>

    <!-- Classes that switch the process-wide UnknownDataHandlings strategy and aren't in
         testng-opensearch.xml: run one class at a time so the switch can't leak. -->
    <!-- Additional test execution for EbeanEntityServiceTest with CDC mode -->
    <test name="ebean-entity-service-cdc">
        <parameter name="cdcMode" value="true"/>
        <classes>
            <class name="com.linkedin.metadata.entity.EbeanEntityServiceTest"/>
        </classes>
    </test>
</suite>