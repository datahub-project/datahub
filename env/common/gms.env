# Queue lag must include search visibility before acknowledging a record.
ES_BULK_ACK_AFTER_TRANSFER=true
POLICY_CACHE_REFRESH_INTERVAL_SECONDS=10

# Copied from the Docker quickstart (docker/profiles/docker-compose.gms.yml and
# docker/datahub-gms/env/docker.env), which does not read this file yet.
# smoke-test/check_env_parity.py reports any difference between the two.

# Compose sets these as ${KEY:-default}, so the shell may override them here too.
ALTERNATE_MCP_VALIDATION=${ALTERNATE_MCP_VALIDATION:-true}
STRICT_URN_VALIDATION_ENABLED=${STRICT_URN_VALIDATION_ENABLED:-true}
ENTITY_VERSIONING_ENABLED=${ENTITY_VERSIONING_ENABLED:-true}
THEME_V2_DEFAULT=${THEME_V2_DEFAULT:-true}
SHOW_HAS_SIBLINGS_FILTER=${SHOW_HAS_SIBLINGS_FILTER:-true}
SHOW_SEARCH_BAR_AUTOCOMPLETE_REDESIGN=${SHOW_SEARCH_BAR_AUTOCOMPLETE_REDESIGN:-true}
SEARCH_BAR_API_VARIANT=${SEARCH_BAR_API_VARIANT:-SEARCH_ACROSS_ENTITIES}
SHOW_HOME_PAGE_REDESIGN=${SHOW_HOME_PAGE_REDESIGN:-true}
DEV_TOOLING_ENABLED=${DEV_TOOLING_ENABLED:-false}
VIEW_AUTHORIZATION_ENABLED=${VIEW_AUTHORIZATION_ENABLED:-false}
DATAHUB_BASE_PATH=${DATAHUB_BASE_PATH:-/}
DATAHUB_GMS_BASE_PATH=${DATAHUB_GMS_BASE_PATH:-/}
MCL_CONSUMER_BATCH_ENABLED=${MCL_CONSUMER_BATCH_ENABLED:-true}
USAGE_AGGREGATION_ENABLED=${USAGE_AGGREGATION_ENABLED:-true}
USAGE_AGGREGATION_FLUSH_INTERVAL_SECONDS=${USAGE_AGGREGATION_FLUSH_INTERVAL_SECONDS:-30}
USAGE_AGGREGATION_ALIGNMENT_PERIOD_SECONDS=${USAGE_AGGREGATION_ALIGNMENT_PERIOD_SECONDS:-3600}
USAGE_AGGREGATION_INCLUDE_AGENT_NAME=${USAGE_AGGREGATION_INCLUDE_AGENT_NAME:-true}

# From the GMS image env (docker/datahub-gms/env/docker.env).
ELASTICSEARCH_LIMIT_RESULTS_STRICT=true
GRAPH_SERVICE_DIFF_MODE_ENABLED=true
ENTITY_SERVICE_ENABLE_RETENTION=true
UI_INGESTION_ENABLED=true
CONFIG_ENTITY_REGISTRY_USE_OPTIMIZED_LOADING=true
GRAPHQL_SHAPE_LOGGING_ENABLED=false
GRAPHQL_SHAPE_LOGGING_FIELD_COUNT_THRESHOLD=100
GRAPHQL_SHAPE_LOGGING_DURATION_THRESHOLD_MS=3000
GRAPHQL_SHAPE_LOGGING_RESPONSE_SIZE_THRESHOLD_BYTES=1048576
GRAPHQL_SHAPE_LOGGING_ERROR_COUNT_THRESHOLD=1
ZDU_STAGE_10=true
ZDU_STAGE_20=true
