# Docker-free stack: connection settings shared by each enabled service. ${GMS_LITE_*} values come from the launcher (ports and per-stack secrets).

DATAHUB_GMS_HOST=localhost
DATAHUB_GMS_PORT=${GMS_LITE_GMS_PORT}
DATAHUB_GMS_URL=http://localhost:${GMS_LITE_GMS_PORT}

# Required credentials (no application.yaml defaults). Generated once per stack and shared by every
# process; nothing here is reachable outside the local harness.
DATAHUB_SYSTEM_CLIENT_ID=__datahub_system
DATAHUB_SYSTEM_CLIENT_SECRET=${GMS_LITE_SYSTEM_CLIENT_SECRET}
METADATA_SERVICE_AUTH_ENABLED=${GMS_LITE_AUTH}
