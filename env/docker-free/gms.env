# Docker-free stack: GMS (also read by system-update and restore-indices).

# Storage: H2 file per instance, schema generated by Ebean (EbeanAspectDao has an H2 branch).
# No IGNORECASE: production MySQL uses a binary collation, so URNs differing only by case are
# distinct rows (the user-siblings fixture relies on that).
EBEAN_DATASOURCE_URL=jdbc:h2:file:${GMS_LITE_INSTANCE_DIR}/gms;MODE=MySQL
EBEAN_DATASOURCE_DRIVER=org.h2.Driver
EBEAN_DATASOURCE_USERNAME=sa
EBEAN_DATASOURCE_PASSWORD=
# Ebean's autocreate is drop-all + create-all at startup, so only system-update may run it
# (system-update.env); GMS would otherwise wipe the freshly bootstrapped DB.
EBEAN_AUTOCREATE=false
DATAHUB_SQL_SETUP_ENABLED=false

# Transport: production pgqueue path over the in-memory store, no Kafka/Postgres.
DATAHUB_MESSAGING_TRANSPORT=pgqueue
DATAHUB_PGQUEUE_ENABLED=true
DATAHUB_PGQUEUE_STORE=inmemory
# system-update writes its MCLs here at exit; GMS loads them at boot and its MAE hooks index the
# bootstrap entities (in production Kafka/Postgres carries them across).
DATAHUB_PGQUEUE_INMEMORY_SPOOL_FILE=${GMS_LITE_INSTANCE_DIR}/queue-spool.json
# Idle consumers back off from the shared floor, doubling up to each topic's ceiling (defaults 1 s
# and 5 s). Tests poll for a write's MCL, so they waited out that backoff: the in-memory store makes
# an empty poll cheap, so keep the fixed 5 ms MCL / 10 ms other sleeps this stack used before the
# backoff. MCL ceiling = floor, so MCL polls stay fixed at 5 ms.
DATAHUB_PGQUEUE_EMPTY_POLL_SLEEP_MIN_MS=5
DATAHUB_PGQUEUE_MAE_MCL_EMPTY_POLL_SLEEP_MS=5
DATAHUB_PGQUEUE_MAE_USAGE_EMPTY_POLL_SLEEP_MS=10
DATAHUB_PGQUEUE_MCE_MCP_EMPTY_POLL_SLEEP_MS=10
DATAHUB_PGQUEUE_PE_EMPTY_POLL_SLEEP_MS=10
SCHEMA_REGISTRY_TYPE=INTERNAL
KAFKA_SCHEMAREGISTRY_URL=http://localhost:${GMS_LITE_GMS_PORT}/schema-registry/api
MAE_CONSUMER_ENABLED=true
MCE_CONSUMER_ENABLED=true
PE_CONSUMER_ENABLED=true

# Documentation file uploads (createDataHubFile) need an object store; the quickstart uses the same
# local-filesystem provider.
DATAHUB_OBJECT_STORAGE_URI=${GMS_LITE_INSTANCE_DIR_URI}/object-storage

# Search/graph: shared embedded OpenSearch, isolated by index prefix. Production bulk semantics
# (refresh policy NONE, 1 s flush, 1 s index refresh). Measured alternatives: WAIT_UNTIL parks each
# write until the next scheduled refresh and IMMEDIATE forces a refresh per document; both
# throttled the MCL consumer to 1-2 documents per second on the shared node. Read-after-write for
# tests comes from the same production paths the Docker lane relies on: UI-sourced writes are
# indexed synchronously before the response and the seeder sends X-DataHub-Sync-Index-Update.
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=${GMS_LITE_OPENSEARCH_PORT}
INDEX_PREFIX=${GMS_LITE_INDEX_PREFIX}
GRAPH_SERVICE_IMPL=elasticsearch
ES_BULK_REQUESTS_LIMIT=100
ES_BULK_FLUSH_PERIOD=1
ES_BULK_REFRESH_POLICY=NONE
# The MAE hook acks the pgqueue offset once the document is handed to the async bulk processor, so
# the lag API reads 0 before it is searchable and test sync helpers return early (Kafka offset lag
# hides this in Docker). Flush and wait per record instead.
# One node: replicas can never allocate (yellow forever); 1 s refresh for read-after-write.
ELASTICSEARCH_NUM_SHARDS_PER_INDEX=1
ELASTICSEARCH_NUM_REPLICAS_PER_INDEX=0
ELASTICSEARCH_INDEX_BUILDER_REFRESH_INTERVAL_SECONDS=1
# Timeseries and usage indices have their own interval (product default 60 s); smoke tests read
# assertion run events, profiles and usage right after writing, so match run-quickstart.sh (1 s)
# or every such read waits up to a minute.
ELASTICSEARCH_INDEX_REFRESH_INTERVAL_TIMESERIES_SECONDS=1
ELASTICSEARCH_INDEX_REFRESH_INTERVAL_USAGE_SECONDS=1
ELASTICSEARCH_INDEX_BUILDER_SETTINGS_REINDEX=true
ELASTICSEARCH_INDEX_BUILDER_MAPPINGS_REINDEX=true
# The embedded node has no ISM plugin, which CreateUsageEventIndicesStep needs. The launcher skips
# the step and pre-creates the usage-event index with the proper keyword mappings instead
# (ensure_usage_event_index); without them `type` becomes dynamic text and the analytics
# resolver's term queries return zero hits.
SKIP_CREATE_USAGE_EVENT_INDICES_STEP=true

# Single-process lifecycle: system-update runs to completion before GMS starts.
BOOTSTRAP_SYSTEM_UPDATE_WAIT_FOR_SYSTEM_UPDATE=false
# --no-auth (Playwright lane): no Play frontend, callers identify themselves with X-DataHub-Actor
# through the Vite preview; policies still apply. --auth (pytest lane): real token auth, the
# launcher mints an admin token into stack.json and the smoke harness mints per-user tokens
# through GraphQL instead of logging in through Play.
# Smoke tests that flip policies wait up to 60 s for the cache to reflect a denial.

ENTITY_REGISTRY_CONFIG_PATH=${GMS_LITE_REPO_ROOT}/metadata-models/src/main/resources/entity-registry.yml
# The OAuth2 issuer URI defaults from this; without it the advertised jwks_uri is wrong on every
# slot but 0.
DATAHUB_BASE_URL=http://localhost:${GMS_LITE_FRONTEND_PORT}
SERVER_PORT=${GMS_LITE_GMS_PORT}
GMS_LITE_INSTANCE=${GMS_LITE_INSTANCE}
SERVER_ADDRESS=127.0.0.1
ELASTICSEARCH_SHIM_ENGINE_TYPE=OPENSEARCH_${GMS_LITE_OPENSEARCH_VERSION}
ELASTICSEARCH_SHIM_AUTO_DETECT=false
ELASTICSEARCH_INDEX_DOC_IDS_SCHEMA_FIELD_HASH_ID_ENABLED=${GMS_LITE_SCHEMA_FIELD_HASH_ID_ENABLED}
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=${GMS_LITE_TOKEN_SIGNING_KEY}
DATAHUB_TOKEN_SERVICE_SALT=${GMS_LITE_TOKEN_SALT}
