# Smoke tests: GMS (--job smoke-test).
#
# Copied from the inline flags of quickstart_compose() in smoke-test/run-quickstart.sh, which the
# Docker quickstart still uses. smoke-test/check_env_parity.py reports any difference.

DATAHUB_TELEMETRY_ENABLED=false
# Tests that grant a policy expect the authorizer to see it within seconds; the cache refreshes
# only on this schedule.
POLICY_CACHE_REFRESH_INTERVAL_SECONDS=2

# UI defaults the smoke and Playwright tests expect.
THEME_V2_DEFAULT=false
SHOW_HAS_SIBLINGS_FILTER=false
SHOW_SEARCH_BAR_AUTOCOMPLETE_REDESIGN=false
SHOW_HOME_PAGE_REDESIGN=true
SEARCH_BAR_API_VARIANT=AUTOCOMPLETE_FOR_MULTIPLE
DEV_TOOLING_ENABLED=true
MCP_SERVER_ENABLED=true

# run-quickstart.sh exports this so Prometheus usage-aggregation waits stay short.
USAGE_AGGREGATION_FLUSH_INTERVAL_SECONDS=${USAGE_AGGREGATION_FLUSH_INTERVAL_SECONDS:-5}
# Compose's value; env/docker-free/gms.env sets 1 for every other local stack.
ELASTICSEARCH_INDEX_REFRESH_INTERVAL_USAGE_SECONDS=3

