# Env applied to every service in the smoke stack, including the standalone
# MAE/MCE consumers. run-quickstart.sh passes it as DATAHUB_LOCAL_COMMON_ENV.

# wait_for_writes_to_sync() waits until the consumers' committed offsets pass the
# write, and KafkaEventConsumerFactory auto-commits every 10s. Hooks finish in
# milliseconds, so each wait used to last until the next commit, which put most
# tests on a 10s step. Spring applies spring.kafka.consumer.properties after that
# default, so this overrides it in the GMS and standalone MAE/MCE consumers.
SPRING_KAFKA_CONSUMER_PROPERTIES_AUTO_COMMIT_INTERVAL_MS=500

# With commits that frequent, an offset can be committed before the MAE consumer's
# async bulk write reaches OpenSearch (up to the 1s flush period, then the 1s index
# refresh), so a search right after wait_for_writes_to_sync() could miss the write.
# Acking after the bulk transfer makes a committed offset mean the document is
# indexed, which leaves only the refresh interval that the wait already sleeps out.
ES_BULK_ACK_AFTER_TRANSFER=true
